# AgentOffice MVP
# Do not put real provider keys in repository files.

AGENT_OFFICE_MODE=mock
AGENTOFFICE_AGENT_MODE=mock

# Runtime directories.
AGENT_OFFICE_TASK_ROOT=.ai/tasks
AGENT_OFFICE_LOG_DIR=.ai/logs
AGENT_OFFICE_TMP_DIR=.ai/tmp
AGENT_OFFICE_CONTEXT_DIR=.ai/context
AGENT_OFFICE_CODEX_DIR=.ai/codex
AGENT_OFFICE_GROK_DIR=.ai/grok
AGENT_OFFICE_CLAUDE_DIR=.ai/claude

# Codex implement adapter. Leave AGENTOFFICE_CODEX_MODE=mock for default mock mode.
AGENTOFFICE_CODEX_MODE=mock
AGENTOFFICE_CODEX_ENABLED=true
AGENTOFFICE_CODEX_DRY_RUN=
AGENTOFFICE_CODEX_FALLBACK_TO_MOCK=false
AGENTOFFICE_CODEX_ALLOW_NON_DRY_RUN=false
AGENTOFFICE_CODEX_CAN_EXECUTE_COMMANDS=false
AGENTOFFICE_CODEX_CAN_NETWORK=false
OPENAI_API_KEY=
AGENTOFFICE_CODEX_TIMEOUT_SECONDS=1200
AGENTOFFICE_CODEX_MAX_FILES=80
AGENTOFFICE_CODEX_MAX_INPUT_CHARS=24000
AGENTOFFICE_CODEX_MAX_OUTPUT_CHARS=12000
AGENTOFFICE_CODEX_MAX_COST_USD=0

# Gemini context adapter. Leave AGENTOFFICE_GEMINI_MODE=mock for default mock mode.
AGENTOFFICE_GEMINI_MODE=mock
AGENTOFFICE_GEMINI_ENABLED=true
AGENTOFFICE_GEMINI_DRY_RUN=
AGENTOFFICE_GEMINI_FALLBACK_TO_MOCK=false
AGENTOFFICE_GEMINI_ALLOW_NON_DRY_RUN=false
AGENTOFFICE_GEMINI_CAN_EXECUTE_COMMANDS=false
AGENTOFFICE_GEMINI_CAN_NETWORK=false
GEMINI_API_KEY=
AGENTOFFICE_GEMINI_TIMEOUT_SECONDS=120
AGENTOFFICE_GEMINI_MAX_FILES=80
AGENTOFFICE_GEMINI_MAX_INPUT_CHARS=20000
AGENTOFFICE_GEMINI_MAX_OUTPUT_CHARS=12000
AGENTOFFICE_GEMINI_MAX_COST_USD=0

# Grok red-team adapter. Leave AGENTOFFICE_GROK_MODE=mock for default mock mode.
AGENTOFFICE_GROK_MODE=mock
AGENTOFFICE_GROK_ENABLED=true
AGENTOFFICE_GROK_DRY_RUN=
AGENTOFFICE_GROK_FALLBACK_TO_MOCK=false
AGENTOFFICE_GROK_ALLOW_NON_DRY_RUN=false
AGENTOFFICE_GROK_CAN_EXECUTE_COMMANDS=false
AGENTOFFICE_GROK_CAN_NETWORK=false
XAI_API_KEY=
AGENTOFFICE_GROK_TIMEOUT_SECONDS=120
AGENTOFFICE_GROK_MAX_INPUT_CHARS=24000
AGENTOFFICE_GROK_MAX_OUTPUT_CHARS=12000
AGENTOFFICE_GROK_MAX_COST_USD=0

# Claude final judge adapter. Leave AGENTOFFICE_CLAUDE_MODE=mock for default mock mode.
AGENTOFFICE_CLAUDE_MODE=mock
AGENTOFFICE_CLAUDE_ENABLED=true
AGENTOFFICE_CLAUDE_DRY_RUN=
AGENTOFFICE_CLAUDE_FALLBACK_TO_MOCK=false
AGENTOFFICE_CLAUDE_ALLOW_NON_DRY_RUN=false
AGENTOFFICE_CLAUDE_CAN_EXECUTE_COMMANDS=false
AGENTOFFICE_CLAUDE_CAN_NETWORK=false
ANTHROPIC_API_KEY=
AGENTOFFICE_CLAUDE_TIMEOUT_SECONDS=120
AGENTOFFICE_CLAUDE_MAX_INPUT_CHARS=16000
AGENTOFFICE_CLAUDE_MAX_OUTPUT_CHARS=12000
AGENTOFFICE_CLAUDE_MAX_COST_USD=0
