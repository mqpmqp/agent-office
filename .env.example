# AgentOffice MVP
# Do not put real provider keys in repository files.

AGENT_OFFICE_MODE=mock
AGENTOFFICE_AGENT_MODE=mock

# Runtime directories.
AGENT_OFFICE_TASK_ROOT=.ai/tasks
AGENT_OFFICE_LOG_DIR=.ai/logs
AGENT_OFFICE_TMP_DIR=.ai/tmp

# Codex adapter. Leave AGENTOFFICE_CODEX_CMD empty to force mock mode.
AGENTOFFICE_CODEX_CMD=
AGENTOFFICE_CODEX_TIMEOUT_SECONDS=1200

# Gemini context adapter. Leave AGENTOFFICE_GEMINI_CMD empty to force mock mode.
AGENTOFFICE_GEMINI_CMD=
AGENTOFFICE_GEMINI_TIMEOUT_SECONDS=120
AGENTOFFICE_GEMINI_MAX_FILES=80
AGENTOFFICE_GEMINI_MAX_OUTPUT_CHARS=12000

# Grok red-team adapter. Leave AGENTOFFICE_GROK_CMD empty to force mock mode.
AGENTOFFICE_GROK_CMD=
AGENTOFFICE_GROK_TIMEOUT_SECONDS=120
AGENTOFFICE_GROK_MAX_OUTPUT_CHARS=12000

# Reserved for future real provider adapters.
# GEMINI_API_KEY=
# GROK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
